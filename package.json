{
  "name": "@theobourgeois/ytdb",
  "version": "0.1.2",
  "description": "A fast, local-first PostgreSQL browser.",
  "homepage": "https://ytdb.theobourgeois.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theobourgeois/YTDB.git"
  },
  "bugs": "https://github.com/theobourgeois/YTDB/issues",
  "private": false,
  "bin": {
    "ytdb": "bin/ytdb.mjs"
  },
  "files": [
    ".next/BUILD_ID",
    ".next/*.json",
    ".next/server",
    ".next/static",
    "bin",
    "public"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev --port 4371 --hostname 127.0.0.1",
    "dev:convex": "convex dev",
    "build": "next build --webpack",
    "start": "next start --port 4371 --hostname 127.0.0.1",
    "lint": "eslint",
    "log": "node scripts/activity-log.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "lucide-react": "^1.39.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
